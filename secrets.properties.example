# Скопируйте этот файл в secrets.properties (он в .gitignore) и задайте свои значения.
#
# jwt.secret — ключ подписи HS512. Должен быть НЕ КОРОЧЕ 64 байт (символов).
# Сгенерировать новый ключ:  openssl rand -base64 64   (или в Java: KeyGenerator.getInstance("HmacSHA512"))
jwt.secret=PASTE-YOUR-64+CHARS-SECRET-HERE-0123456789-abcdefghijklmnop-QRSTUVWXYZ-abcd
#
# spring.datasource.password=PASTE-YOUR-MYSQL-PASSWORD
#
# Авто-создание администратора при старте (если такого e-mail ещё нет в таблице users).
# Раскомментируйте — и вход в админку фронтенда появится «из коробки».
# Пароль лучше сменить сразу после первого входа.
#
# app.admin.email=admin@clothes.shop
# app.admin.password=ChangeMe123!
# app.admin.firstName=Admin
# app.admin.lastName=Shop
#
# ---------- SMTP: подтверждение регистрации по e-mail (PIN-код) ----------
# Если эти строки не заданы — письма не уходят, а PIN печатается в логе бэкенда
# (строка "PIN-код подтверждения регистрации"), что удобно для локальной разработки.
# Значения подставляются в application.properties видам ${MAIL_HOST:...} и т.п.,
# поэтому писать spring.mail.host.* здесь не нужно.
# MAIL_HOST=smtp.gmail.com
# MAIL_PORT=587
# MAIL_USERNAME=your.account@gmail.com
# MAIL_PASSWORD=пароль-приложения
# MAIL_FROM=noreply@clothes.shop
# VERIFICATION_ENABLED=false   # false — отключить подтверждение e-mail (только для разработки!)
